# Copy to .env and fill in your real values. NEVER commit .env.

PORT=4000
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h

SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_EMAIL=admin@questionbank.local

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

MAIL_ENABLED=false
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Question Bank <no-reply@questionbank.local>

# Frontend URL used in password-reset links
APP_BASE_URL=http://localhost:5173

# Optional comma-separated allowlist, e.g. https://question-bank.vercel.app
# If empty, CORS stays open (all origins allowed).
CORS_ORIGINS=